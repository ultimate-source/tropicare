# Keep .env files out of Docker build context
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.hypothesis/
.venv/
venv/

# Node
frontend/node_modules/
frontend/.next/

# Git / IDE
.git/
.gitignore
.vscode/
.idea/

# Kiro
.kiro/

# Keys (mounted as secrets, not baked in)
keys/

# Tests and docs (not needed in production images)
tests/
docs/
*.md
