
# --- Required secrets ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...          # for text-embedding-3-large
# --- Database (matches docker-compose defaults) ---
DATABASE_URL=postgresql://tropicare:tropicare@localhost:5432/tropicare
REDIS_URL=redis://localhost:6379/0

# --- Services ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tropicare_knowledge
MCP_URL=http://localhost:8001

# --- Model ---
MODEL=claude-sonnet-4-6

# --- Auth ---
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_PRIVATE_KEY_PATH=keys/private.pem

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Eval ---
EVAL_GATEWAY_URL=http://localhost:8000
MODEL_VERSION=claude-sonnet-4-6
ENABLE_LLM_JUDGES=0   # set to 1 for full eval (costs API tokens)
