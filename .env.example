# ─────────────────────────────────────────────────────────────────────────────
# TropiCare — Environment Variables
# Copy to .env and fill in your API keys
# ─────────────────────────────────────────────────────────────────────────────

# Required API keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Grafana admin password (change in production)
GRAFANA_ADMIN_PASSWORD=tropicare

# MongoDB Atlas — set to use Atlas for vector search (both local dev and production)
# Leave unset to use the local Docker MongoDB container instead
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
# MONGODB_DB=tropicare
